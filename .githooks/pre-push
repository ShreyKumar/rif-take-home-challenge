#!/bin/sh
#
# Block direct pushes to the protected branch. Changes must land on it via a
# feature branch + pull request.
#
# Activate in a fresh clone with:
#     git config core.hooksPath .githooks
#
# Emergency override: git push --no-verify
#
protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
		echo "" >&2
		echo "  ✋ Direct pushes to '$protected_branch' are blocked." >&2
		echo "     Create a feature branch and open a pull request instead:" >&2
		echo "" >&2
		echo "       git switch -c phase-N-something" >&2
		echo "       git push -u origin phase-N-something   # then open a PR" >&2
		echo "" >&2
		echo "     (Emergency override: git push --no-verify)" >&2
		echo "" >&2
		exit 1
	fi
done

exit 0
